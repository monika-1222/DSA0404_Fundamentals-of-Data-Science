      "source": [
        "import os\n",
        "import re\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from collections import Counter\n",
        "import nltk\n",
        "from nltk.corpus import stopwords\n",
        "\n",
        "# Ensure NLTK stopwords are downloaded\n",
        "nltk.download('stopwords', quiet=True)\n",
        "stop_words = set(stopwords.words('english'))\n",
        "\n",
        "# Dataset path\n",
        "file_path = \"/content/drive/MyDrive/FoDS/Document from Monika\"\n",
        "\n",
        "# Helper function to read the dataset dynamically with fallback encoding\n",
        "def load_data(path):\n",
        "    # If the file path does not exist directly, look for files starting with that name\n",
        "    if not os.path.exists(path):\n",
        "        dir_name = os.path.dirname(path)\n",
        "        base_name = os.path.basename(path)\n",
        "        if os.path.exists(dir_name):\n",
        "            candidates = [os.path.join(dir_name, f) for f in os.listdir(dir_name) if base_name in f]\n",
        "            if candidates:\n",
        "                path = candidates[0]\n",
        "                print(f\"Resolved actual file path to: {path}\")\n",
        "            else:\n",
        "                raise FileNotFoundError(f\"Could not find file with base name: {base_name}\")\n",
        "        else:\n",
        "            raise FileNotFoundError(f\"Directory not found: {dir_name}\")\n",
        "\n",
        "    # Determine reader based on extension\n",
        "    _, ext = os.path.splitext(path.lower())\n",
        "    if ext == '.csv':\n",
        "        try:\n",
        "            return pd.read_csv(path, encoding='utf-8')\n",
        "        except UnicodeDecodeError:\n",
        "            print(\"UTF-8 decoding failed. Retrying with 'latin-1' encoding...\")\n",
        "            return pd.read_csv(path, encoding='latin-1')\n",
        "    elif ext in ['.xlsx', '.xls']:\n",
        "        return pd.read_excel(path)\n",
        "    else:\n",
        "        # Default fallback to CSV\n",
        "        try:\n",
        "            return pd.read_csv(path, encoding='utf-8')\n",
        "        except UnicodeDecodeError:\n",
        "            print(\"UTF-8 decoding failed. Retrying with 'latin-1' encoding...\")\n",
        "            return pd.read_csv(path, encoding='latin-1')\n",
        "\n",
        "try:\n",
        "    df_feedback = load_data(file_path)\n",
        "    print(\"Dataset successfully loaded!\")\n",
        "\n",
        "    # Prioritize columns like 'Review Text', 'Review', 'feedback', or 'text'\n",
        "    potential_cols = ['Review Text', 'Review', 'feedback', 'text', 'comments']\n",
        "    col_name = None\n",
        "    for candidate in potential_cols:\n",
        "        # Check case-insensitive match\n",
        "        matched = [col for col in df_feedback.columns if col.strip().lower() == candidate.lower()]\n",
        "        if matched:\n",
        "            col_name = matched[0]\n",
        "            break\n",
        "\n",
        "    if not col_name:\n",
        "        # Fallback to the first non-numeric/object type column or just the first column\n",
        "        text_cols = df_feedback.select_dtypes(include=['object']).columns\n",
        "        col_name = text_cols[0] if len(text_cols) > 0 else df_feedback.columns[0]\n",
        "\n",
        "    print(f\"Analyzing column: '{col_name}'\")\n",
        "\n",
        "    # 1. Clean and preprocess text\n",
        "    raw_texts = df_feedback[col_name].dropna().astype(str).tolist()\n",
        "    all_text = \" \".join(raw_texts).lower()\n",
        "\n",
        "    # Extract alphanumeric words (removes punctuation)\n",
        "    words = re.findall(r'\\b[a-z0-9]+\\b', all_text)\n",
        "\n",
        "    # Eliminate stop words\n",
        "    filtered_words = [word for word in words if word not in stop_words]\n",
        "\n",
        "    # 2. Calculate frequency distribution\n",
        "    word_counts = Counter(filtered_words)\n",
        "\n",
        "    # 3. Get user input N for top words to show\n",
        "    try:\n",
        "        N = int(input(\"Enter the number of top words to display and plot (N): \"))\n",
        "    except Exception:\n",
        "        N = 10\n",
        "        print(\"Invalid input. Defaulting to N=10.\")\n",
        "\n",
        "    top_words = word_counts.most_common(N)\n",
        "    freq_df = pd.DataFrame(top_words, columns=['Word', 'Frequency'])\n",
        "\n",
        "    print(f\"\\nTop {N} Most Frequent Words:\")\n",
        "    print(freq_df.to_string(index=False))\n",
        "\n",
        "    # 4. Plot top N frequent words\n",
        "    sns.set_theme(style=\"whitegrid\")\n",
        "    plt.figure(figsize=(10, 5))\n",
        "    sns.barplot(x='Frequency', y='Word', data=freq_df, hue='Word', palette='mako', legend=False)\n",
        "    plt.title(f'Top {N} Most Frequent Words in {col_name}', fontsize=14)\n",
        "    plt.xlabel('Frequency')\n",
        "    plt.ylabel('Words')\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "except Exception as e:\n",
        "    print(f\"An error occurred: {e}\")"
      ],
